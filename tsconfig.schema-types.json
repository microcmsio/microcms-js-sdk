{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "microcms-js-sdk": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/typedSchema.typecheck.ts"],
  "exclude": ["node_modules"]
}
