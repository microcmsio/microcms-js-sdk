{
  "name": "microcms-js-sdk",
  "version": "3.6.0",
  "description": "JavaScript SDK Client for microCMS.",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/microcms-js-sdk.js",
  "module": "./dist/esm/microcms-js-sdk.js",
  "unpkg": "./dist/umd/microcms-js-sdk.js",
  "types": "./dist/microcms-js-sdk.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/microcmsio/microcms-js-sdk.git"
  },
  "author": "microCMS",
  "license": "Apache-2.0",
  "keywords": [
    "JavaScript",
    "node",
    "SDK",
    "microCMS"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.declarations.json && node scripts/finish-declarations.mjs",
    "postbuild": "mkdir -p ./dist/umd/ && cp -pR ./dist/iife/* ./dist/umd",
    "lint": "oxlint ./src ./tests ./examples",
    "lint:fix": "oxlint --fix ./src ./tests ./examples",
    "format": "prettier --check ./src ./tests ./examples",
    "format:fix": "prettier --write ./src ./tests ./examples",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "test": "jest --coverage=false",
    "test:coverage": "jest --coverage=true",
    "typecheck:schema": "tsc --noEmit --project tsconfig.schema-types.json",
    "typecheck:dist": "tsc --noEmit --project tsconfig.schema-dist.json",
    "test:types": "node scripts/check-typescript.mjs",
    "typecheck:examples": "tsc --noEmit --project examples/tsconfig.json",
    "test:performance": "node scripts/check-type-performance.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "async-retry": "^1.3.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "jest": "^29.7.0",
    "msw": "^2.2.3",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
