{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "microcms-js-sdk": [".."]
    }
  },
  "include": ["./usage/**/*.ts", "./generated/**/*.ts"]
}
